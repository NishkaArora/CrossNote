# Copy to .env for local runs. Never commit .env.

# Labeller identity (required)
LABELER_DID=did:plc:...
LABELER_SIGNING_KEY=...            # hex secp256k1 key for signing labels

# Account that posts the note replies (required)
BSKY_HANDLE=your-labeler.bsky.social
BSKY_PASSWORD=...                  # an app password, not the account password

# Matcher (required for automatic labelling)
OPENAI_API_KEY=sk-...

# Library build only (library/build.py): X API v2 bearer token
X_BEARER_TOKEN=

# Behaviour
CROSSNOTE_MODE=followers           # "followers" or "full"
CROSSNOTE_DRY_RUN=1                # keep at 1 locally: log matches, never label or reply
MAX_REPLIES_PER_HOUR=20            # full mode only
# EXCLUDED_DIDS=did:plc:...,did:plc:...   # accounts that asked to be excluded
# DISABLE_AUTO_LABEL=1             # serve labels only via /admin/label
# ADMIN_TOKEN=                     # enables /admin/label; openssl rand -hex 32

# Demo page (demo/): origins allowed to POST /demo/feedback, comma-separated
DEMO_ORIGINS=http://localhost:8000

# Local paths (defaults are the Fly volume, /data)
DATA_DIR=./local-data
DATABASE_URL=file:./local-data/labeler.db
LIBRARY_ROOT=./data/library            # where library/build.py writes snapshots
STAGE3_LOG_PATH=./local-data/crossnote_stage3.jsonl
